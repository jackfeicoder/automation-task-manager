{
  "id": "edge-rewards",
  "name": "Edge Microsoft Rewards",
  "description": "复用桌面 Edge 的登录信息执行当天搜索和简单活动，仅关闭任务页面；默认允许 VPN 和代理。首次用 start_edge.ps1 打开桌面 Edge。",
  "enabled": false,
  "command": ["{python}", "main.py", "--run"],
  "cwd": "tasks/edge_rewards",
  "schedule": {"kind": "daily", "time": "10:00", "timezone": "Asia/Shanghai"},
  "timeout_seconds": 1800,
  "max_attempts": 1,
  "resource_group": "edge-rewards-local-account",
  "daily_once": false,
  "env_names": ["REWARDS_EDGE_ENDPOINT", "REWARDS_REQUIRE_DIRECT_NETWORK", "REWARDS_COUNTRY_CODE", "REWARDS_SEARCH_COUNT", "REWARDS_SEARCH_INTERVAL", "REWARDS_ACTION_WAIT", "REWARDS_MAX_ACTIVITIES", "REWARDS_POLL_OPTION"]
}
