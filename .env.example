# Local listener. Run one server process: the scheduler shares its lifecycle.
AUTOMATION_HOST=127.0.0.1
AUTOMATION_PORT=8765
# Optional protection for the management UI/API. Leave blank for loopback use.
AUTOMATION_API_TOKEN=
# Optional WorkBuddy overrides. Otherwise use the local desktop login file.
WORKBUDDY_AUTH_FILE=
WORKBUDDY_ACCESS_TOKEN=
WORKBUDDY_USER_ID=
WORKBUDDY_DOMAIN=
# Publishing reads GITHUB_TOKEN from your existing environment.
# Do not paste GitHub credentials into this example file.
